# LOCAL generation runner only. Never expose as VITE_ variables.
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_MODEL=gpt-5-nano
GEMINI_MODEL=gemini-3.1-flash-lite

# Enforced by the local runner.
GENERATION_MAX_DECISIONS=10
GENERATION_MAX_RETRIES_PER_TEAM_DECISION=1
GENERATION_MAX_ESTIMATED_USD=0.25
# Optional additional provider ceilings, also in USD. Zero prevents any request to that provider.
# GENERATION_MAX_OPENAI_USD=0.10
# GENERATION_MAX_GEMINI_USD=0.15
